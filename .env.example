# Sao chép file này thành .env (KHÔNG commit .env)

# ----- API (backend/brew-lite) -----
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Dùng từ Sprint 2 khi nối PostgreSQL (khớp docker-compose.yml)
DATABASE_URL=postgresql://root:123@localhost:5432/brewlite
JWT_SECRET=change-me

# ----- Web (frontend/brewlite) -----
# Đặt vào frontend/brewlite/.env.local. Bỏ trống = dùng dữ liệu giả, không cần chạy API.
NEXT_PUBLIC_API_URL=http://localhost:4000
