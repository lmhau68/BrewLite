@startuml deployment-brewlite
title BrewLite - Deployment diagram (production, đề xuất: Render + GHCR)
skinparam shadowing false

node "Thiết bị người dùng" as device {
  artifact "Trình duyệt / PWA" as browser
}

node "GitHub (CI)" as ci {
  artifact "GitHub Actions\nLint -> Test -> Build -> Docker" as actions
  database "GitHub Secrets" as secrets
}

node "GitHub Container Registry" as ghcr {
  artifact "brewlite-web:<sha>" as imgweb
  artifact "brewlite-api:<sha>" as imgapi
}

node "Render (production)" as render {
  node "Web Service (container)" as webc {
    artifact "Next.js  :3000" as web
  }
  node "API Service (container)" as apic {
    artifact "NestJS  :4000\nGET /health" as api
  }
  node "Managed PostgreSQL (private)" as dbn {
    database "PostgreSQL  :5432\npersistent disk" as db
  }
  artifact "Environment variables\n(DATABASE_URL, JWT_SECRET, CORS_ORIGIN)" as env
}

node "Local (developer)" as local {
  artifact "docker-compose: web + api + db\nnpm run dev" as compose
}

browser --> web : HTTPS :443
browser --> api : HTTPS :443\nREST/JSON + JWT
api --> db : TCP :5432\nmạng nội bộ, không public
actions --> imgweb : push image
actions --> imgapi : push image
actions --> render : deploy + migrate\n(secret của CI)
secrets ..> actions
imgweb ..> web : pull
imgapi ..> api : pull
env ..> api
note right of api : Log ra stdout -> Render Logs\nHealth check: GET /health
note bottom of local : Ranh giới: Local | CI | Production
@enduml
